<%layout("/layouts/boilerplate")%>
<%- include("../includes/filters.ejs")%>
<%- include("../includes/search.ejs")%>
<div class="row row-cols-1 row-cols-md-2  row-cols-sm-2 row-cols-lg-3 g-4 mt-3" >
    <% for(let listing of allListings) { %>

<div class="card  col" >
  <a href="/listings/<%= listing._id %>" class="listing-link"> 
  <!-- <img src="<%= listing.image?.url || listing.image %>" class="card-img-top" alt="listing_image"> -->
  <img src="<%= listing.image.url %>"  class="card-img-top" alt="listing image" style="height: 20rem">
  <div class="card-img-overlay"></div>
  <div class="card-body">
   <p><b><%= listing.title %></b> </br>
     
      &#8377; <%= listing.price.toLocaleString("en-IN") %>
    </p>
    
  </div>
  </a>
</div>

<%}%>

</div>


   
    

